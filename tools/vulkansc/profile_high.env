# Environment of the export sessions of the "high" profile (sourced by export_pipelines.sh).
# The swapchain format of the Vulkan SC display: VK_FORMAT_B8G8R8A8_UNORM, which the VulkanSC-Emulation
# display offers. The swapchain render passes, and the pipelines that draw into them, name it.
WZ_VULKAN_FORCE_SWAPCHAIN_FORMAT=44
